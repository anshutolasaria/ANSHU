# Copy to .env for local scripts, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Any long random string (letters, numbers, _ and - only). Telegram sends it
# back with every request so the bot can reject anything not from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram chat IDs allowed to use the bot (Meera's chat ID).
# Message the bot once and it will reply with your chat ID.
ALLOWED_CHAT_IDS=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: defaults to gemini-3.8-flash
GEMINI_MODEL=

# Optional: overrides prompts/voice-instructions.md if set
VOICE_INSTRUCTIONS=

# Optional: Google News edition used for the news lookup (defaults: IN and en)
NEWS_REGION=
NEWS_LANGUAGE=
